# Barangay Documents Delivery System - Apache Configuration
# This file helps ensure proper routing for the PHP application

# Enable RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Set the base directory for rewrites
    # This ensures that relative paths work correctly
    RewriteBase /
    
    # If the requested file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Ensure PHP files are processed
    <FilesMatch "\.php$">
        SetHandler application/x-httpd-php
    </FilesMatch>
</IfModule>

# Set directory index files
DirectoryIndex index.php index.html

# Security: Prevent directory listing
Options -Indexes

# Security: Protect data directory
<IfModule mod_authz_core.c>
    <Directory "data">
        Require all denied
    </Directory>
</IfModule>

# PHP Settings
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log logs/php_errors.log
</IfModule>

# Set default charset
AddDefaultCharset UTF-8

# Enable compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
